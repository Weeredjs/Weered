{
  "name": "weered",
  "private": true,
  "packageManager": "pnpm@10.29.3",
  "scripts": {
    "infra:up": "docker compose up -d postgres redis livekit",
    "infra:down": "docker compose down",
    "desktop": "pnpm --filter @weered/desktop dev",
    "desktop:build": "pnpm --filter @weered/desktop build",
    "mobile": "pnpm --filter @weered/mobile start:go",
    "web": "pnpm --filter @weered/web dev",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "bash scripts/check.sh",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.3.8",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "26.6.3",
    "@types/ws": "^8.18.2",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "typescript-eslint": "^8.71.0"
  },
  "dependencies": {
    "@expo/ngrok": "^4.1.3"
  },
  "pnpm": {
    "overrides": {
      "fast-uri": ">=4.1.2",
      "ws": ">=8.20.1",
      "shell-quote": ">=1.9.0",
      "esbuild": ">=0.28.1",
      "postcss": ">=8.5.18",
      "uuid": ">=11.1.1",
      "@opentelemetry/core": ">=2.8.0",
      "js-yaml": ">=4.3.0 <5",
      "@babel/core": ">=7.29.6 <8",
      "find-my-way": ">=9.7.0",
      "form-data": ">=4.0.6",
      "brace-expansion@1": ">=1.1.18 <2",
      "brace-expansion@2": ">=2.1.4 <3",
      "brace-expansion@5": ">=5.0.8",
      "sharp": ">=0.35.0"
    }
  },
  "license": "UNLICENSED",
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,yml,yaml,html}": [
      "prettier --write"
    ]
  }
}
